# ==========================================
# KWIZZ Radio - Environment Configuration
# ==========================================

# Server Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Station Details
STATION_NAME="KWIZZ Radio"
STATION_TAGLINE="Ottawa's Premier Reggae & Dancehall Internet Radio"
STATION_TIMEZONE="America/Toronto"
DEFAULT_STREAM_URL=https://streaming.live365.com/b72076_128k.mp3
LIVE365_STATION_ID=a72076

# Database Driver ('firebase' or 'prisma')
DATABASE_DRIVER=firebase

# Firebase Configuration (Firestore & Auth)
FIREBASE_PROJECT_ID=kwizz-radio-ottawa
# Option A: Path to service account JSON (recommended)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option B: Direct credentials in env
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Database (PostgreSQL via Prisma - optional when DATABASE_DRIVER=prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwizz_radio?schema=public"

# Redis (Cache, Rate Limiting, Pub/Sub)
REDIS_URL="redis://localhost:6379"

# Session & Security Secrets
SESSION_SECRET=super_secret_session_key_min_32_characters_long_for_security!
CSRF_SECRET=csrf_secret_random_hash_key_min_32_characters_long!
COOKIE_SECURE=false

# Web Push (VAPID)
VAPID_PUBLIC_KEY=BExampleVAPIDPublicKeyReplaceWithRealGeneratedKey1234567890
VAPID_PRIVATE_KEY=ExampleVAPIDPrivateKeyReplaceWithRealGeneratedKey123
VAPID_SUBJECT="mailto:admin@kwizzradio.ca"

# SMTP Mailer (Song requests, contact form notifications)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=test_smtp_user
SMTP_PASS=test_smtp_password
CONTACT_EMAIL=info@kwizzradio.ca
STAFF_ALERT_EMAIL=djs@kwizzradio.ca

# Bot / Spam Protection (reCAPTCHA / hCaptcha)
CAPTCHA_SECRET_KEY=optional_test_captcha_secret
CAPTCHA_SITE_KEY=optional_test_captcha_site_key

# Station Features Toggle
APP_BADGES_ENABLED=false
APP_STORE_URL=https://apps.apple.com/app/kwizz-radio
GOOGLE_PLAY_URL=https://play.google.com/store/apps/details?id=ca.kwizzradio.app

