<div class="space-y-8">
  <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
    <div>
      <h1 class="text-2xl font-black text-white">Manage Radio Shows</h1>
      <p class="text-xs text-zinc-400">Define show programs, descriptions, and musical genres.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <div class="lg:col-span-5 bg-zinc-950 border border-zinc-800 p-6 rounded-3xl space-y-4">
      <h3 class="text-base font-bold text-white">Create New Show</h3>
      
      <form action="/admin/shows/create" method="POST" class="space-y-4 text-xs">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div>
          <label class="block font-bold uppercase text-zinc-400 mb-1">Show Title</label>
          <input type="text" name="title" required placeholder="e.g. Kingston Dub Hour" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
        </div>

        <div>
          <label class="block font-bold uppercase text-zinc-400 mb-1">Genre</label>
          <input type="text" name="genre" required value="Reggae / Dancehall" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
        </div>

        <div>
          <label class="block font-bold uppercase text-zinc-400 mb-1">Assigned DJ</label>
          <select name="djId" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
            <option value="">-- Station General Mix --</option>
            <% djs.forEach(d => { %>
              <option value="<%= d.id %>"><%= d.name %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="block font-bold uppercase text-zinc-400 mb-1">Description</label>
          <textarea name="description" rows="3" required placeholder="Describe the show program..." class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white resize-none"></textarea>
        </div>

        <button type="submit" class="w-full py-3 rounded-xl btn-primary-gold uppercase tracking-wider">
          Create Show
        </button>
      </form>
    </div>

    <div class="lg:col-span-7 bg-zinc-950 border border-zinc-800 p-6 rounded-3xl space-y-4">
      <h3 class="text-base font-bold text-white">Active Shows</h3>
      
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="border-b border-zinc-800 text-zinc-500 font-bold uppercase">
            <tr>
              <th class="py-2">Title</th>
              <th class="py-2">Genre</th>
              <th class="py-2">DJ ID</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-900">
            <% if (shows && shows.length > 0) { %>
              <% shows.forEach(s => { %>
                <tr class="hover:bg-zinc-900/40">
                  <td class="py-2.5 font-bold text-white"><%= s.title %></td>
                  <td class="py-2.5 text-amber-400"><%= s.genre %></td>
                  <td class="py-2.5 text-zinc-400"><%= s.djId || 'None' %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="3" class="py-4 text-center text-zinc-500">No shows created yet.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

