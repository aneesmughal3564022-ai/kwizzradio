<div class="space-y-8 max-w-4xl mx-auto">
  <div class="border-b border-zinc-800 pb-4">
    <h1 class="text-2xl font-black text-white">Station Settings &amp; Audio Stream</h1>
    <p class="text-xs text-zinc-400">Manage stream URLs, station metadata, and feature flags.</p>
  </div>

  <form action="/admin/settings/update" method="POST" class="bg-zinc-950 border border-zinc-800 p-8 rounded-3xl space-y-6 shadow-xl text-xs">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <!-- Primary Audio Stream URL -->
    <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-700/80 space-y-2">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <label for="set-stream" class="font-extrabold uppercase text-white tracking-wider text-sm">Primary Stream URL</label>
      </div>
      <p class="text-[11px] text-zinc-400 leading-relaxed">
        The official audio stream endpoint used by the persistent sticky player across all devices. No redistribution or audio proxying is performed.
      </p>
      <input 
        type="url" 
        id="set-stream" 
        name="stream_url" 
        required 
        value="<%= env.DEFAULT_STREAM_URL %>"
        class="w-full px-4 py-3 rounded-xl bg-black border border-zinc-700/80 text-amber-400 font-mono text-xs focus:outline-none focus:ring-2 focus:ring-amber-400">
    </div>

    <!-- Station Identity -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label class="block font-bold uppercase text-zinc-400 mb-1">Station Name</label>
        <input type="text" name="station_name" value="<%= env.STATION_NAME %>" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
      </div>
      <div>
        <label class="block font-bold uppercase text-zinc-400 mb-1">Live365 Station ID</label>
        <input type="text" name="live365_station_id" value="<%= env.LIVE365_STATION_ID %>" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
      </div>
    </div>

    <div>
      <label class="block font-bold uppercase text-zinc-400 mb-1">Station Tagline</label>
      <input type="text" name="station_tagline" value="<%= env.STATION_TAGLINE %>" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
    </div>

    <div>
      <label class="block font-bold uppercase text-zinc-400 mb-1">Staff Alert &amp; Contact Email</label>
      <input type="email" name="contact_email" value="<%= env.CONTACT_EMAIL %>" class="w-full px-3 py-2.5 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
    </div>

    <!-- Mobile App Badges Flag (PRD 5.9) -->
    <div class="p-5 rounded-2xl bg-zinc-900 border border-zinc-800 space-y-2">
      <div class="flex items-center justify-between">
        <div>
          <label for="set-badges" class="font-bold text-white uppercase text-xs">Mobile App Store Badges</label>
          <p class="text-[11px] text-zinc-400">Enable App Store &amp; Google Play badges in website footer.</p>
        </div>
        <select id="set-badges" name="app_badges_enabled" class="px-3 py-1.5 rounded-lg bg-black border border-zinc-700 text-amber-400 font-bold">
          <option value="false" <%= !env.APP_BADGES_ENABLED ? 'selected' : '' %>>Disabled (App not released yet)</option>
          <option value="true" <%= env.APP_BADGES_ENABLED ? 'selected' : '' %>>Enabled (Live in App Stores)</option>
        </select>
      </div>
    </div>

    <!-- Social Links -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div>
        <label class="block font-bold uppercase text-zinc-400 mb-1">Instagram</label>
        <input type="url" name="social_instagram" value="https://instagram.com/kwizzradio" class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
      </div>
      <div>
        <label class="block font-bold uppercase text-zinc-400 mb-1">Facebook</label>
        <input type="url" name="social_facebook" value="https://facebook.com/kwizzradio" class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
      </div>
      <div>
        <label class="block font-bold uppercase text-zinc-400 mb-1">X / Twitter</label>
        <input type="url" name="social_twitter" value="https://x.com/kwizzradio" class="w-full px-3 py-2 rounded-xl bg-zinc-900 border border-zinc-700 text-white">
      </div>
    </div>

    <button type="submit" class="w-full py-3.5 rounded-xl btn-primary-gold text-sm uppercase tracking-wider shadow-lg">
      Save All Settings
    </button>
  </form>
</div>

