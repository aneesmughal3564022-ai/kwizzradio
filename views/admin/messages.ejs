<div class="space-y-6">
  <div class="flex items-center justify-between border-b border-zinc-800 pb-4">
    <div>
      <h1 class="text-2xl font-black text-white">Contact Inquiries Inbox</h1>
      <p class="text-xs text-zinc-400">Incoming messages from listeners, promoters, and advertisers.</p>
    </div>
  </div>

  <div class="bg-zinc-950 border border-zinc-800 rounded-3xl p-6 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="border-b border-zinc-800 text-zinc-500 font-bold uppercase">
          <tr>
            <th class="py-3">Date</th>
            <th class="py-3">From</th>
            <th class="py-3">Subject</th>
            <th class="py-3">Message</th>
            <th class="py-3">Status</th>
            <th class="py-3 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-900">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(m => { %>
              <tr class="hover:bg-zinc-900/40">
                <td class="py-3 text-zinc-500 whitespace-nowrap"><%= new Date(m.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric' }) %></td>
                <td class="py-3">
                  <div class="font-bold text-white"><%= m.name %></div>
                  <div class="text-[10px] text-zinc-400"><%= m.email %></div>
                </td>
                <td class="py-3 font-semibold text-amber-400"><%= m.subject || 'General' %></td>
                <td class="py-3 text-zinc-300 max-w-sm truncate"><%= m.message %></td>
                <td class="py-3">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase <%= m.status === 'REPLIED' ? 'bg-emerald-950 text-emerald-400' : (m.status === 'ARCHIVED' ? 'bg-zinc-800 text-zinc-400' : 'bg-amber-950 text-amber-400') %>">
                    <%= m.status %>
                  </span>
                </td>
                <td class="py-3 text-right space-x-1 whitespace-nowrap">
                  <a href="mailto:<%= m.email %>?subject=Re: <%= encodeURIComponent(m.subject || 'KWIZZ Radio') %>" class="px-2.5 py-1 rounded bg-zinc-900 hover:bg-zinc-800 text-amber-400 font-bold text-[10px] inline-block">Reply Email</a>
                  <form action="/admin/messages/<%= m.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="REPLIED">
                    <button type="submit" class="px-2.5 py-1 rounded bg-zinc-900 hover:bg-zinc-800 text-emerald-400 font-bold text-[10px]">Mark Replied</button>
                  </form>
                  <form action="/admin/messages/<%= m.id %>/status" method="POST" class="inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="status" value="ARCHIVED">
                    <button type="submit" class="px-2.5 py-1 rounded bg-zinc-900 hover:bg-zinc-800 text-zinc-400 font-bold text-[10px]">Archive</button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr><td colspan="6" class="py-8 text-center text-zinc-500">No contact inquiries yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

