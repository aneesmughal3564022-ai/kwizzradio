<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-black text-white min-h-screen flex items-center justify-center p-4">
  <div class="w-full max-w-md space-y-6">
    <div class="text-center space-y-2">
      <div class="w-16 h-16 rounded-2xl bg-gradient-to-tr from-amber-400 to-amber-500 text-black flex items-center justify-center font-black text-2xl mx-auto shadow-xl shadow-amber-400/20">
        KZ
      </div>
      <h1 class="text-2xl font-black text-white">KWIZZ Radio Staff Portal</h1>
      <p class="text-xs text-zinc-400">Secure access for station managers, editors &amp; DJs</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="p-4 rounded-xl bg-rose-950/80 border border-rose-500/40 text-rose-400 text-xs font-semibold">
        <%= error %>
      </div>
    <% } %>

    <form action="/admin/login" method="POST" class="bg-zinc-950/90 border border-zinc-800/80 p-8 rounded-3xl shadow-2xl space-y-4 backdrop-blur-md">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div>
        <label for="login-email" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">Email Address</label>
        <input 
          type="email" 
          id="login-email" 
          name="email" 
          required 
          placeholder="admin@kwizzradio.ca"
          class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm">
      </div>

      <div>
        <label for="login-pass" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">Password</label>
        <input 
          type="password" 
          id="login-pass" 
          name="password" 
          required 
          placeholder="••••••••••••"
          class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm">
      </div>

      <div>
        <label for="login-2fa" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">
          2FA Code <span class="text-zinc-500 font-normal">(Optional TOTP)</span>
        </label>
        <input 
          type="text" 
          id="login-2fa" 
          name="twoFactorCode" 
          placeholder="6-digit code"
          class="w-full px-4 py-3 rounded-xl bg-zinc-900 border border-zinc-700/80 text-white placeholder-zinc-500 focus:outline-none focus:ring-2 focus:ring-amber-400 text-sm">
      </div>

      <button 
        type="submit" 
        class="w-full py-3.5 rounded-xl btn-primary-gold text-sm uppercase tracking-wider shadow-lg">
        Secure Login &rarr;
      </button>
    </form>

    <div class="text-center text-xs text-zinc-600">
      <a href="/" class="hover:text-amber-400 transition-colors">&larr; Return to Live Radio</a>
    </div>
  </div>
</body>
</html>

