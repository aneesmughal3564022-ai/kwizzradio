<!-- PIPEDA, CASL & GDPR Compliant Cookie Consent Banner -->
<div id="cookie-consent-banner" class="fixed bottom-24 left-4 right-4 sm:left-auto sm:right-6 sm:max-w-md z-50 p-5 rounded-2xl backdrop-blur-md border shadow-2xl hidden" style="background-color: var(--modal-bg); border-color: var(--border-color); color: var(--text-primary);">
  <div class="flex items-start gap-3 mb-3">
    <div class="p-2 rounded-xl badge-gold shrink-0">
      <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/></svg>
    </div>
    <div>
      <h3 class="text-sm font-bold" style="color: var(--text-primary);">Your Privacy Choices</h3>
      <p class="text-xs mt-1 leading-relaxed" style="color: var(--text-secondary);">
        KWIZZ Radio respects Canadian privacy laws (PIPEDA &amp; CASL) and GDPR. We use essential cookies to keep the audio player alive and optional privacy-friendly analytics to improve our station.
      </p>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row items-center gap-2 pt-2 border-t" style="border-color: var(--border-color);">
    <button id="cookie-accept-all" type="button" class="w-full sm:w-auto flex-1 px-4 py-2.5 rounded-xl text-xs font-bold btn-primary-gold cursor-pointer">
      Accept All
    </button>
    <button id="cookie-essential-only" type="button" class="w-full sm:w-auto px-4 py-2.5 rounded-xl text-xs font-semibold border transition-colors cursor-pointer" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
      Essential Only
    </button>
    <a href="/privacy" class="text-[11px] underline py-1 hover:text-amber-500" style="color: var(--text-muted);">
      Policy
    </a>
  </div>
</div>
