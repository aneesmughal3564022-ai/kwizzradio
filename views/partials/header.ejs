<header class="sticky top-0 z-40 backdrop-blur-xl border-b transition-colors" style="background-color: var(--header-bg); border-color: var(--border-color);">
  <div class="reggae-stripe"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="KWIZZ Radio Home">
        <div class="relative w-10 h-10 rounded-xl p-[2px] bg-gradient-to-br from-emerald-500 via-amber-400 to-rose-500 shadow-md group-hover:scale-105 transition-transform">
          <div class="w-full h-full rounded-[10px] flex items-center justify-center font-black text-base tracking-tighter" style="background-color: var(--bg-card); color: var(--reggae-gold);">
            KZ
          </div>
        </div>
        <div>
          <div class="flex items-center gap-1.5">
            <span class="font-black text-xl tracking-tight transition-colors" style="color: var(--text-primary);">KWIZZ</span>
            <span class="text-[10px] px-1.5 py-0.5 rounded font-black tracking-wider bg-rose-600 text-white shadow-sm">RADIO</span>
          </div>
          <p class="text-[9px] tracking-widest uppercase font-semibold" style="color: var(--text-muted);">Internet Radio &bull; 24/7</p>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center space-x-1 lg:space-x-1.5" aria-label="Main Navigation">
        <a href="/" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'home' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'home' ? '' : 'color: var(--text-secondary);' %>">Home</a>
        <a href="/listen" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'listen' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'listen' ? '' : 'color: var(--text-secondary);' %>">Listen Live</a>
        <a href="/schedule" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'schedule' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'schedule' ? '' : 'color: var(--text-secondary);' %>">Schedule</a>
        <a href="/djs" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'djs' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'djs' ? '' : 'color: var(--text-secondary);' %>">DJs</a>
        <a href="/events" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'events' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'events' ? '' : 'color: var(--text-secondary);' %>">Events</a>
        <a href="/request" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'request' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'request' ? '' : 'color: var(--text-secondary);' %>">Request Song</a>
        <a href="/sponsors" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'sponsors' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'sponsors' ? '' : 'color: var(--text-secondary);' %>">Sponsors</a>
        <a href="/contact" class="nav-link px-3 py-1.5 rounded-xl text-xs lg:text-sm font-semibold transition-all <%= page === 'contact' ? 'text-amber-500 font-bold bg-amber-400/10 border border-amber-400/30' : 'hover:bg-amber-400/10' %>" style="<%= page === 'contact' ? '' : 'color: var(--text-secondary);' %>">Contact</a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Live Status Pill -->
        <div class="hidden sm:flex items-center gap-2 px-3 py-1 rounded-full badge-emerald text-xs font-bold" title="Station is broadcasting live 24/7 on internet radio">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>ON AIR</span>
        </div>

        <!-- Internet Radio Badge -->
        <div class="hidden xl:flex items-center gap-1.5 px-2.5 py-1 rounded-full badge-gold text-[10px] font-bold tracking-wider" title="100% Digital Internet Radio - No FM/AM Needed">
          <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          <span>INTERNET RADIO</span>
        </div>

        <!-- Social Icons -->
        <div class="hidden lg:flex items-center gap-1.5" style="color: var(--text-muted);">
          <a href="https://instagram.com/kwizzradio" target="_blank" rel="noopener noreferrer" aria-label="KWIZZ Radio Instagram" class="p-2 rounded-lg hover:text-amber-500 hover:bg-amber-400/10 transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
          </a>
          <a href="https://facebook.com/kwizzradio" target="_blank" rel="noopener noreferrer" aria-label="KWIZZ Radio Facebook" class="p-2 rounded-lg hover:text-amber-500 hover:bg-amber-400/10 transition-all">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.7 5H18V0h-3.808C10.597 0 9 1.583 9 4.615V8z"/></svg>
          </a>
        </div>

        <!-- Theme Toggle Button -->
        <button id="theme-toggle-btn" type="button" class="theme-toggle-btn p-2 rounded-xl border transition-all focus:ring-2 focus:ring-amber-400 cursor-pointer pointer-events-auto" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);" aria-label="Switch between light and dark theme" title="Toggle theme">
          <span class="theme-icon flex items-center justify-center pointer-events-none">
            <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </span>
        </button>

        <!-- Mobile Menu Hamburger Button -->
        <button id="mobile-menu-btn" type="button" class="md:hidden p-2 rounded-xl border transition-all focus:outline-none focus:ring-2 focus:ring-amber-400" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);" aria-controls="mobile-menu" aria-expanded="false" aria-label="Toggle navigation menu">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t px-4 pt-3 pb-6 space-y-1 transition-all" style="background-color: var(--modal-bg); border-color: var(--border-color);">
    <a href="/" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Home</a>
    <a href="/listen" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Listen Live</a>
    <a href="/schedule" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Schedule</a>
    <a href="/djs" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">DJs</a>
    <a href="/events" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Events</a>
    <a href="/request" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Request Song</a>
    <a href="/sponsors" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Sponsors</a>
    <a href="/contact" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">Contact</a>
    <a href="/about" class="block px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500" style="color: var(--text-primary);">About KWIZZ Radio</a>
    <div class="pt-2 border-t mt-2" style="border-color: var(--border-color);">
      <button type="button" class="theme-toggle-btn w-full flex items-center justify-between px-3 py-2 rounded-xl text-sm font-semibold transition-colors hover:bg-amber-400/10 hover:text-amber-500 cursor-pointer" style="color: var(--text-primary);">
        <span>Toggle Light / Dark Theme</span>
        <span class="theme-icon flex items-center justify-center pointer-events-none">
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </span>
      </button>
    </div>
  </div>
</header>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (btn && menu) {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', !expanded);
        menu.classList.toggle('hidden');
      });
    }
  });
</script>
