<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'KWIZZ Radio Admin' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="/css/tailwind.css">
</head>
<body class="bg-black text-white min-h-screen flex flex-col antialiased">
  
  <!-- Admin Navigation Bar -->
  <header class="border-b border-zinc-800/80 bg-zinc-950/90 backdrop-blur-md px-4 py-3 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/admin" class="flex items-center gap-2 font-black text-lg text-white">
          <span class="w-7 h-7 rounded-lg bg-gradient-to-br from-amber-400 to-amber-500 text-black flex items-center justify-center font-black text-xs shadow-md shadow-amber-400/20">KZ</span>
          <span>KWIZZ <span class="text-amber-400">ADMIN</span></span>
        </a>
        <span class="text-xs px-2 py-0.5 rounded font-bold uppercase tracking-wider bg-zinc-800/80 text-zinc-300 border border-zinc-700/60">
          <%= user ? user.role : 'STAFF' %>
        </span>
      </div>

      <nav class="hidden md:flex items-center gap-4 text-xs font-semibold">
        <a href="/admin" class="text-zinc-300 hover:text-white">Dashboard</a>
        <a href="/admin/schedule" class="text-zinc-300 hover:text-white">Schedule</a>
        <a href="/admin/djs" class="text-zinc-300 hover:text-white">DJs</a>
        <a href="/admin/shows" class="text-zinc-300 hover:text-white">Shows</a>
        <a href="/admin/announcements" class="text-zinc-300 hover:text-white">Announcements</a>
        <a href="/admin/requests" class="text-zinc-300 hover:text-white">Requests</a>
        <a href="/admin/messages" class="text-zinc-300 hover:text-white">Messages</a>
        <a href="/admin/sponsors" class="text-zinc-300 hover:text-white">Sponsors</a>
        <% if (user && user.role === 'ADMIN') { %>
          <a href="/admin/settings" class="text-zinc-300 hover:text-white">Settings</a>
          <a href="/admin/audit" class="text-zinc-300 hover:text-white">Audit</a>
        <% } %>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="text-xs text-amber-400 hover:underline flex items-center gap-1 font-semibold">
          <span>Live Site &nearr;</span>
        </a>
        <form action="/admin/logout" method="POST" class="inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-zinc-800/80 hover:bg-zinc-700 border border-zinc-700/60 text-zinc-300 hover:text-white transition-colors">
            Logout
          </button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
    <%- body %>
  </main>

  <footer class="border-t border-zinc-900 bg-black text-center py-4 text-xs text-zinc-600">
    KWIZZ Radio Station Control Panel &bull; Ottawa, ON
  </footer>
</body>
</html>

