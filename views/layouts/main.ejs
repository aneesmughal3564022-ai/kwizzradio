<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= typeof title !== 'undefined' ? title : 'KWIZZ Radio | Ottawa Reggae & Dancehall 24/7 Internet Radio' %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Stream KWIZZ Radio live worldwide. Ottawa Premier 24/7 Reggae, Dancehall, and Caribbean online internet radio station with non-stop music and live DJ programming.' %>">

  <!-- PWA & Mobile Icons -->
  <link rel="manifest" href="/manifest.json">
  <meta name="theme-color" content="#08080a">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="KWIZZ">
  <meta name="application-name" content="KWIZZ">
  <link rel="icon" type="image/svg+xml" href="/images/fallback-album.svg">
  <link rel="apple-touch-icon" href="/images/fallback-album.svg">

  <!-- Open Graph & Twitter Cards -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'KWIZZ Radio - 24/7 Internet Radio' %>">
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Ottawa Premier 24/7 Reggae & Dancehall Worldwide Internet Radio Station.' %>">
  <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '/images/fallback-album.svg' %>">
  <meta property="og:type" content="music.radio_station">
  <meta property="og:url" content="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : 'http://localhost:3000' %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:site" content="@kwizzradio">

  <!-- Compiled Tailwind & Reggae Theme Stylesheet -->
  <link rel="stylesheet" href="/css/tailwind.css?v=2">

  <!-- Immediate Theme Initializer & Controller (Synchronous in <head> to prevent flash and ensure instant toggle availability) -->
  <script src="/js/theme.js?v=2"></script>

  <!-- JSON-LD Structured Data for RadioStation -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "RadioStation",
    "name": "KWIZZ Radio",
    "alternateName": "KWIZZ",
    "url": "http://localhost:3000",
    "genre": ["Reggae", "Dancehall", "Roots", "Caribbean"],
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Ottawa",
      "addressRegion": "ON",
      "addressCountry": "CA"
    },
    "broadcaster": {
      "@type": "Organization",
      "name": "KWIZZ Radio"
    }
  }
  </script>
</head>
<body class="flex flex-col min-h-screen antialiased selection:bg-amber-400 selection:text-black transition-colors duration-200">
  
  <!-- Accessible Skip to Content Link (WCAG 2.1 AA) -->
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-amber-400 focus:text-black focus:font-bold focus:rounded-lg">
    Skip to main content
  </a>

  <!-- Announcement Banner -->
  <%- include('../partials/announcement') %>

  <!-- Station Header -->
  <%- include('../partials/header') %>

  <!-- Main Dynamic Content Area (Swapped seamlessly by navigation.js) -->
  <main id="main-content" role="main" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8">
    <%- body %>
  </main>

  <!-- Station Footer -->
  <%- include('../partials/footer') %>

  <!-- Persistent Sticky Audio Player (Never reloaded on page navigation) -->
  <%- include('../partials/player') %>

  <!-- Cookie Consent Banner -->
  <%- include('../partials/cookie-banner') %>

  <!-- Scripts -->
  <script src="/js/player.js"></script>
  <script src="/js/navigation.js"></script>
  <script src="/js/sse-client.js"></script>
  <script src="/js/push-client.js"></script>
  <script src="/js/analytics.js"></script>
</body>
</html>
