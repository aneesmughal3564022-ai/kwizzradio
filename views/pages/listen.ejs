<!-- Dedicated Listening Lounge View -->
<div class="space-y-10 max-w-5xl mx-auto">
  <div class="text-center space-y-3">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full badge-emerald text-xs font-semibold">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
      <span>128 KBPS HIGH DEFINITION LIVE FEED &bull; 100% INTERNET RADIO</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black" style="color: var(--text-primary);">
      KWIZZ Radio &bull; Listening Lounge
    </h1>
    <p class="text-sm sm:text-base max-w-xl mx-auto" style="color: var(--text-secondary);">
      Pure roots, reggae, and dancehall broadcast straight from Ottawa, Canada to the world on 24/7 internet radio.
    </p>
  </div>

  <!-- Giant Interactive Visualizer & Player Card -->
  <div class="rounded-3xl kwizz-card p-8 sm:p-12 shadow-2xl relative overflow-hidden text-center transition-all" style="background-color: var(--bg-card); border-color: var(--border-color);">
    <div class="absolute -top-32 -left-32 w-80 h-80 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-32 -right-32 w-80 h-80 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <div class="relative z-10 flex flex-col items-center">
      <!-- Live Status Pill -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-emerald text-xs font-bold mb-5">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span id="listen-live-badge">ON AIR &bull; 24/7 LIVE STREAM</span>
      </div>

      <!-- Vinyl / Artwork Showcase -->
      <div class="relative w-48 h-48 sm:w-64 sm:h-64 rounded-2xl overflow-hidden shadow-2xl border-2 mb-6 group" style="background-color: var(--bg-card); border-color: var(--border-color);">
        <img id="listen-page-art" src="<%= typeof liveTrack !== 'undefined' && liveTrack && liveTrack.artwork ? liveTrack.artwork : '/images/fallback-album.svg' %>" alt="Now Playing Track Artwork" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/fallback-album.svg';" referrerpolicy="no-referrer">
        <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-xs">
          <button onclick="if(window.player) window.player.toggle()" class="w-16 h-16 rounded-full btn-primary-gold flex items-center justify-center shadow-xl transform hover:scale-110 active:scale-95 transition-transform cursor-pointer" aria-label="Toggle Playback">
            <svg class="w-8 h-8 fill-current translate-x-0.5 text-zinc-950" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>

      <h2 id="listen-page-title" class="text-2xl sm:text-3xl font-black truncate max-w-lg mb-1" style="color: var(--text-primary);">
        <%= typeof liveTrack !== 'undefined' && liveTrack && liveTrack.title ? liveTrack.title : 'KWIZZ Radio Live' %>
      </h2>
      <p id="listen-page-artist" class="text-base sm:text-lg font-bold text-amber-500 truncate max-w-lg mb-3">
        <%= typeof liveTrack !== 'undefined' && liveTrack && liveTrack.artist ? liveTrack.artist : "Ottawa's Reggae & Dancehall • Worldwide Stream" %>
      </p>

      <!-- Live Track Progress Display -->
      <div class="w-full max-w-sm mx-auto space-y-1.5 mb-5 px-4">
        <div class="flex items-center justify-between text-xs font-mono font-bold tabular-nums" style="color: var(--text-muted);">
          <span id="listen-time-elapsed">0:00</span>
          <span class="text-[10px] uppercase tracking-wider text-amber-500 font-extrabold">24/7 Digital Radio</span>
          <span id="listen-time-remaining">-0:00</span>
        </div>
        <div class="w-full h-2 rounded-full overflow-hidden border" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
          <div id="listen-progress-bar" class="h-full bg-gradient-to-r from-emerald-500 via-amber-400 to-amber-500 rounded-full transition-all duration-300" style="width: 0%;"></div>
        </div>
      </div>

      <!-- Music Purchase / Streaming Links -->
      <div id="listen-track-links" class="flex flex-wrap items-center justify-center gap-2 mb-6">
        <% if (typeof liveTrack !== 'undefined' && liveTrack && liveTrack.appleMusicUrl) { %>
          <a id="listen-apple-music" href="<%= liveTrack.appleMusicUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors hover:border-amber-400" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-1.09 1.73-.95 2.76.99.08 2.06-.51 2.68-1.26z"/></svg>
            <span>Apple Music</span>
          </a>
        <% } %>
        <% if (typeof liveTrack !== 'undefined' && liveTrack && liveTrack.amazonStoreUrl) { %>
          <a id="listen-amazon-music" href="<%= liveTrack.amazonStoreUrl %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold border transition-colors hover:border-amber-400" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M13.792 12 3.61 22.186a1.996 1.996 0 0 1-.61-.92L3 2.734c0-.334.084-.65.228-.92h.381zm11.234 11.238l2.091 2.091-11.7 6.75 9.609-8.841zm0-2.104L5.234 2.107l11.7 6.75-2.091 2.091zm1.488 1.488l2.454-1.417c.809-.467.809-1.229 0-1.696L16.331 10.95 14.22 13.06l2.11 2.11z"/></svg>
            <span>Amazon Music</span>
          </a>
        <% } %>
      </div>

      <!-- Big Play Button for 1-Click Launch -->
      <button onclick="if(window.player) window.player.toggle()" class="px-8 py-4 rounded-2xl btn-primary-gold text-lg flex items-center gap-3 cursor-pointer shadow-lg hover:scale-105 active:scale-95 transition-all">
        <svg class="w-6 h-6 fill-current text-zinc-950" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span class="text-zinc-950 font-black">Play Live Stream</span>
      </button>

      <!-- External Player & Direct Stream Formats -->
      <div class="mt-8 pt-6 border-t w-full max-w-lg flex flex-wrap items-center justify-center gap-3 text-xs" style="border-color: var(--border-color); color: var(--text-muted);">
        <span class="font-bold uppercase tracking-wider text-[10px]">Direct Stream Links:</span>
        <a href="/api/stream.m3u" download="kwizzradio.m3u" class="px-2.5 py-1 rounded-lg border hover:text-amber-500 transition-colors" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
          &darr; M3U Playlist (VLC / iTunes)
        </a>
        <a href="<%= typeof streamUrl !== 'undefined' ? streamUrl : 'https://streaming.live365.com/a77724' %>" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg border hover:text-amber-500 transition-colors" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
          Direct 128k MP3
        </a>
        <a href="https://streaming.live365.com/a77724/playlist.m3u8" target="_blank" rel="noopener noreferrer" class="px-2.5 py-1 rounded-lg border hover:text-amber-500 transition-colors" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
          HLS Stream
        </a>
      </div>
    </div>
  </div>

  <!-- Live365 Official Embedded Player -->
  <div class="rounded-3xl kwizz-card p-6 sm:p-8 shadow-xl space-y-4" style="background-color: var(--bg-card); border-color: var(--border-color);">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-amber-400"></span>
        <h3 class="text-sm font-bold uppercase tracking-wider" style="color: var(--text-primary);">
          Official Live365 Player Widget
        </h3>
      </div>
      <a href="https://live365.com/station/KWIZZ-RADIO-a77724" target="_blank" rel="noopener noreferrer" class="text-xs text-amber-500 hover:underline flex items-center gap-1 font-semibold">
        <span>Station on Live365</span> &nearr;
      </a>
    </div>
    <div class="w-full overflow-hidden rounded-2xl border" style="border-color: var(--border-color);">
      <iframe 
        id="live365-embed-iframe"
        src="<%= typeof embedUrl !== 'undefined' ? embedUrl : 'https://live365.com/embeds/v1/player/a77724?s=md&m=dark&c=mp3' %>" 
        title="KWIZZ Radio Official Live365 Player"
        width="100%" 
        height="145" 
        style="border: none; overflow: hidden; display: block;" 
        allow="autoplay">
      </iframe>
    </div>
  </div>

  <!-- Recently Played Tracks (Last 10) (PRD 5.2) -->
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
        <h3 class="text-lg font-bold" style="color: var(--text-primary);">
          Recently Played on KWIZZ Radio
        </h3>
      </div>
      <span class="text-xs" style="color: var(--text-muted);">Real-time stream history</span>
    </div>

    <ul id="recent-tracks-list" class="space-y-2.5">
      <% if (typeof recentTracks !== 'undefined' && Array.isArray(recentTracks) && recentTracks.length > 0) { %>
        <% recentTracks.forEach((track, idx) => { %>
          <li class="flex items-center justify-between gap-3 p-3.5 rounded-2xl border transition-all hover:scale-[1.005]" style="background-color: var(--bg-card); border-color: var(--border-color);">
            <div class="flex items-center gap-3.5 min-w-0 flex-1">
              <div class="relative w-12 h-12 rounded-xl overflow-hidden shrink-0 border shadow-sm" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
                <img src="<%= track.artwork || '/images/fallback-album.svg' %>" alt="<%= track.title %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/images/fallback-album.svg';" referrerpolicy="no-referrer">
              </div>
              <div class="min-w-0 flex-1">
                <h4 class="text-xs sm:text-sm font-black truncate" style="color: var(--text-primary);"><%= track.title %></h4>
                <p class="text-[11px] sm:text-xs truncate font-medium" style="color: var(--text-secondary);"><%= track.artist %></p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <% if (track.appleMusicUrl) { %>
                <a href="<%= track.appleMusicUrl %>" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold border transition-colors hover:border-amber-400" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
                  <span>Apple Music</span>
                </a>
              <% } %>
              <span class="text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider" style="background-color: var(--button-secondary-bg); color: var(--text-muted);">
                <%= idx === 0 ? 'Just Played' : 'Played' %>
              </span>
            </div>
          </li>
        <% }) %>
      <% } else { %>
        <li class="flex items-center gap-3 p-4 rounded-xl border" style="background-color: var(--bg-card); border-color: var(--border-color);">
          <img src="/images/fallback-album.svg" alt="Track" class="w-10 h-10 rounded-lg object-cover" style="background-color: var(--button-secondary-bg);">
          <div class="min-w-0 flex-1">
            <h4 class="text-xs font-bold truncate" style="color: var(--text-primary);">KWIZZ Radio Live</h4>
            <p class="text-[11px] truncate" style="color: var(--text-secondary);">Ottawa Reggae &amp; Dancehall</p>
          </div>
          <span class="text-[10px]" style="color: var(--text-muted);">Live</span>
        </li>
      <% } %>
    </ul>
  </div>
</div>

<script>
  // Sync page elements with current player state & theme
  (function() {
    function updateIframeTheme(theme) {
      const iframe = document.getElementById('live365-embed-iframe');
      if (!iframe) return;
      const currentTheme = theme || document.documentElement.getAttribute('data-theme') || 'dark';
      const targetMode = currentTheme === 'light' ? 'light' : 'dark';
      iframe.src = `https://live365.com/embeds/v1/player/a77724?s=md&m=${targetMode}&c=mp3`;
    }

    window.addEventListener('kwizz:themechanged', (e) => {
      if (e.detail && e.detail.theme) {
        updateIframeTheme(e.detail.theme);
      }
    });

    // Check theme on initial load
    const curTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    if (curTheme === 'light') {
      updateIframeTheme('light');
    }

    function sync() {
      if (window.player && window.player.currentTrack) {
        const titleEl = document.getElementById('listen-page-title');
        const artistEl = document.getElementById('listen-page-artist');
        const artEl = document.getElementById('listen-page-art');
        if (titleEl) titleEl.textContent = window.player.currentTrack.title;
        if (artistEl) artistEl.textContent = window.player.currentTrack.artist;
        if (artEl && window.player.currentTrack.artwork) artEl.src = window.player.currentTrack.artwork;
      }
    }
    sync();

    // Fetch live now playing data from Live365 API
    fetch('/api/now-playing?_cb=' + Date.now())
      .then(r => r.json())
      .then(res => {
        if (res.success && res.data) {
          const titleEl = document.getElementById('listen-page-title');
          const artistEl = document.getElementById('listen-page-artist');
          const artEl = document.getElementById('listen-page-art');
          if (titleEl) titleEl.textContent = res.data.title || 'KWIZZ Radio Live';
          if (artistEl) artistEl.textContent = res.data.artist || 'Ottawa Reggae & Dancehall';
          if (artEl && res.data.artwork) artEl.src = res.data.artwork;
          if (window.player) window.player.updateMetadata(res.data);
        }
      })
      .catch(() => {});

    // Fetch initial recent tracks
    fetch('/api/recent')
      .then(r => r.json())
      .then(res => {
        if (res.success && Array.isArray(res.data) && res.data.length > 0) {
          const list = document.getElementById('recent-tracks-list');
          if (list) {
            list.innerHTML = res.data.map((track, idx) => `
              <li class="flex items-center justify-between gap-3 p-3.5 rounded-2xl border transition-all hover:scale-[1.005]" style="background-color: var(--bg-card); border-color: var(--border-color);">
                <div class="flex items-center gap-3.5 min-w-0 flex-1">
                  <div class="relative w-12 h-12 rounded-xl overflow-hidden shrink-0 border shadow-sm" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
                    <img src="${track.artwork || '/images/fallback-album.svg'}" alt="${track.title}" class="w-full h-full object-cover" onerror="this.src='/images/fallback-album.svg'">
                  </div>
                  <div class="min-w-0 flex-1">
                    <h4 class="text-xs sm:text-sm font-black truncate" style="color: var(--text-primary);">${track.title}</h4>
                    <p class="text-[11px] sm:text-xs truncate font-medium" style="color: var(--text-secondary);">${track.artist}</p>
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  ${track.appleMusicUrl ? `
                    <a href="${track.appleMusicUrl}" target="_blank" rel="noopener noreferrer" class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold border transition-colors hover:border-amber-400" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
                      <span>Apple Music</span>
                    </a>
                  ` : ''}
                  <span class="text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider" style="background-color: var(--button-secondary-bg); color: var(--text-muted);">
                    ${idx === 0 ? 'Just Played' : 'Played'}
                  </span>
                </div>
              </li>
            `).join('');
          }
        }
      })
      .catch(() => {});
  })();
</script>
