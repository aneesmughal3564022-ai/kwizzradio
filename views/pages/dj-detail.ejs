<!-- DJ Detail Page -->
<div class="space-y-10 max-w-4xl mx-auto">
  <a href="/djs" class="inline-flex items-center gap-1.5 text-xs font-semibold hover:text-amber-500 transition-colors" style="color: var(--text-muted);">
    &larr; Back to all DJs
  </a>

  <div class="rounded-3xl kwizz-card p-6 sm:p-10 shadow-2xl flex flex-col md:flex-row items-center md:items-start gap-8" style="background-color: var(--bg-card); border-color: var(--border-color);">
    <div class="w-44 h-44 sm:w-56 sm:h-56 rounded-2xl border-2 overflow-hidden shrink-0 shadow-lg" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
      <img src="<%= dj.photoUrl || '/images/fallback-album.svg' %>" alt="<%= dj.name %>" class="w-full h-full object-cover">
    </div>

    <div class="space-y-4 text-center md:text-left flex-1">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full badge-gold text-xs font-bold uppercase tracking-wider">
        <span>Official KWIZZ Presenter &bull; KWIZZ Radio</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black" style="color: var(--text-primary);">
        <%= dj.name %>
      </h1>

      <p class="text-sm leading-relaxed" style="color: var(--text-secondary);">
        <%= dj.bio %>
      </p>

      <div class="flex items-center justify-center md:justify-start gap-4 pt-2">
        <% if (dj.socialInstagram) { %>
          <a href="<%= dj.socialInstagram %>" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl border text-xs font-medium flex items-center gap-2 transition-colors hover:text-amber-500" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
            <span>Instagram</span>
          </a>
        <% } %>
        <% if (dj.socialTwitter) { %>
          <a href="<%= dj.socialTwitter %>" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl border text-xs font-medium flex items-center gap-2 transition-colors hover:text-amber-500" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
            <span>X / Twitter</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Shows Hosted -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold" style="color: var(--text-primary);">Shows Hosted by <%= dj.name %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% if (typeof shows !== 'undefined' && shows.length > 0) { %>
        <% shows.forEach(show => { %>
          <div class="p-5 rounded-2xl kwizz-card" style="background-color: var(--bg-card); border-color: var(--border-color);">
            <span class="text-[10px] font-bold uppercase badge-gold px-2 py-0.5 rounded"><%= show.genre %></span>
            <h3 class="text-lg font-bold mt-2" style="color: var(--text-primary);"><%= show.title %></h3>
            <p class="text-xs mt-1 leading-relaxed" style="color: var(--text-secondary);"><%= show.description %></p>
          </div>
        <% }); %>
      <% } else { %>
        <div class="p-6 rounded-2xl kwizz-card text-xs" style="background-color: var(--bg-card); border-color: var(--border-color); color: var(--text-muted);">
          Regular rotation selector across weekly internet radio mixes.
        </div>
      <% } %>
    </div>
  </div>
</div>
