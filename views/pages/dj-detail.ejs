<!-- DJ Detail Page -->
<div class="space-y-10 max-w-4xl mx-auto">
  <a href="/djs" class="inline-flex items-center gap-1.5 text-xs font-semibold text-zinc-400 hover:text-amber-400 transition-colors">
    &larr; Back to all DJs
  </a>

  <div class="rounded-3xl kwizz-card p-6 sm:p-10 shadow-2xl flex flex-col md:flex-row items-center md:items-start gap-8" style="background-color: var(--bg-card);">
    <div class="w-44 h-44 sm:w-56 sm:h-56 rounded-2xl bg-zinc-900 border-2 border-zinc-800/80 overflow-hidden shrink-0 shadow-lg">
      <img src="<%= dj.photoUrl || '/images/fallback-album.svg' %>" alt="<%= dj.name %>" class="w-full h-full object-cover">
    </div>

    <div class="space-y-4 text-center md:text-left flex-1">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full badge-gold text-xs font-bold uppercase tracking-wider">
        <span>Official KWIZZ Presenter</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-black text-white" style="color: var(--text-primary);">
        <%= dj.name %>
      </h1>

      <p class="text-zinc-300 text-sm leading-relaxed">
        <%= dj.bio %>
      </p>

      <div class="flex items-center justify-center md:justify-start gap-4 pt-2">
        <% if (dj.socialInstagram) { %>
          <a href="<%= dj.socialInstagram %>" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs text-white font-medium flex items-center gap-2 transition-colors">
            <span>Instagram</span>
          </a>
        <% } %>
        <% if (dj.socialTwitter) { %>
          <a href="<%= dj.socialTwitter %>" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs text-white font-medium flex items-center gap-2 transition-colors">
            <span>X / Twitter</span>
          </a>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Shows Hosted -->
  <div class="space-y-4">
    <h2 class="text-xl font-bold text-white" style="color: var(--text-primary);">Shows Hosted by <%= dj.name %></h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <% if (typeof shows !== 'undefined' && shows.length > 0) { %>
        <% shows.forEach(show => { %>
          <div class="p-5 rounded-2xl kwizz-card">
            <span class="text-[10px] font-bold uppercase text-amber-400 px-2 py-0.5 rounded bg-zinc-900 border border-zinc-800"><%= show.genre %></span>
            <h3 class="text-lg font-bold text-white mt-2" style="color: var(--text-primary);"><%= show.title %></h3>
            <p class="text-xs text-zinc-400 mt-1 leading-relaxed"><%= show.description %></p>
          </div>
        <% }); %>
      <% } else { %>
        <div class="p-6 rounded-2xl kwizz-card text-xs text-zinc-400">
          Regular rotation selector across weekly mixes.
        </div>
      <% } %>
    </div>
  </div>
</div>

