<!-- KWIZZ Radio DJs & Presenters Roster -->
<div class="space-y-8 max-w-6xl mx-auto">
  <div class="border-b pb-6" style="border-color: var(--border-color);">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-rose text-xs font-semibold mb-2">
      <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
      <span>KWIZZ RADIO TALENT</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black" style="color: var(--text-primary);">
      DJs &amp; Presenters
    </h1>
    <p class="text-sm mt-1" style="color: var(--text-muted);">
      The selectors, mic controllers, and music curators powering KWIZZ Radio's 24/7 internet stream.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% if (typeof djs !== 'undefined' && djs.length > 0) { %>
      <% djs.forEach(dj => { %>
        <article class="kwizz-card overflow-hidden group flex flex-col justify-between" style="background-color: var(--bg-card); border-color: var(--border-color);">
          <div>
            <div class="relative h-56 bg-zinc-900 overflow-hidden">
              <img src="<%= dj.photoUrl || '/images/fallback-album.svg' %>" alt="<%= dj.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/30 to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-amber-400 text-black">
                  Resident DJ
                </span>
                <h2 class="text-xl font-black text-white mt-1">
                  <a href="/djs/<%= dj.slug %>" class="hover:text-amber-400 transition-colors">
                    <%= dj.name %>
                  </a>
                </h2>
              </div>
            </div>

            <div class="p-5 text-xs leading-relaxed" style="color: var(--text-secondary);">
              <%= dj.bio %>
            </div>
          </div>

          <div class="p-5 pt-0 border-t mt-auto flex items-center justify-between" style="border-color: var(--border-color);">
            <a href="/djs/<%= dj.slug %>" class="text-xs font-bold text-amber-500 hover:text-amber-400 flex items-center gap-1">
              View Profile &amp; Shows &rarr;
            </a>

            <!-- Social Links -->
            <div class="flex items-center gap-2" style="color: var(--text-muted);">
              <% if (dj.socialInstagram) { %>
                <a href="<%= dj.socialInstagram %>" target="_blank" rel="noopener noreferrer" class="hover:text-amber-500" aria-label="<%= dj.name %> on Instagram">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
              <% } %>
              <% if (dj.socialTwitter) { %>
                <a href="<%= dj.socialTwitter %>" target="_blank" rel="noopener noreferrer" class="hover:text-amber-500" aria-label="<%= dj.name %> on X">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
              <% } %>
            </div>
          </div>
        </article>
      <% }); %>
    <% } %>
  </div>
</div>
