<!-- KWIZZ Radio Sponsors & Advertising Page -->
<div class="space-y-10 max-w-5xl mx-auto">
  <div class="border-b pb-6 text-center space-y-2" style="border-color: var(--border-color);">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-gold text-xs font-semibold">
      <span>SUPPORT OUR COMMUNITY PARTNERS &bull; KWIZZ RADIO</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black" style="color: var(--text-primary);">
      Sponsors &amp; Advertisers
    </h1>
    <p class="text-sm max-w-xl mx-auto" style="color: var(--text-muted);">
      These businesses and community organizations make independent 24/7 Caribbean internet broadcasting possible in Ottawa and beyond.
    </p>
  </div>

  <!-- Sponsor Directory Grid -->
  <div class="space-y-6">
    <h2 class="text-xl font-bold" style="color: var(--text-primary);">Featured Community Partners</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% if (typeof sponsors !== 'undefined' && sponsors.length > 0) { %>
        <% sponsors.forEach(sp => { %>
          <div class="p-6 kwizz-card flex flex-col items-center text-center justify-between space-y-4" style="background-color: var(--bg-card); border-color: var(--border-color);">
            <div class="w-20 h-20 rounded-2xl border flex items-center justify-center p-3 shadow-inner" style="background-color: var(--button-secondary-bg); border-color: var(--border-color);">
              <img src="<%= sp.logoUrl || '/images/fallback-album.svg' %>" alt="<%= sp.name %>" class="max-h-full max-w-full object-contain">
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-500 block mb-1">
                <%= sp.placement %> PARTNER
              </span>
              <h3 class="text-base font-black" style="color: var(--text-primary);"><%= sp.name %></h3>
            </div>
            <a href="/api/sponsors/<%= sp.id %>/click?target=<%= encodeURIComponent(sp.targetUrl) %>" target="_blank" rel="noopener sponsored" class="w-full py-2.5 rounded-xl border text-xs font-bold transition-colors hover:text-amber-500" style="background-color: var(--button-secondary-bg); border-color: var(--border-color); color: var(--text-primary);">
              Visit Website &rarr;
            </a>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-3 p-8 text-center" style="color: var(--text-muted);">
          No sponsors active at this time.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Advertising Pitch Callout -->
  <div class="rounded-3xl border p-8 sm:p-10 text-center space-y-4 shadow-xl" style="background-color: var(--bg-card); border-color: var(--border-color);">
    <h2 class="text-2xl font-black" style="color: var(--text-primary);">
      Promote Your Business with KWIZZ Radio
    </h2>
    <p class="text-sm max-w-2xl mx-auto leading-relaxed" style="color: var(--text-secondary);">
      Reach thousands of engaged listeners in Ottawa, Gatineau, Montreal, Toronto, and our global Caribbean stream audience. We offer non-intrusive banner placements, sponsored show segments, and live event broadcasts on internet radio.
    </p>
    <a href="/contact" class="inline-block px-7 py-3.5 rounded-2xl btn-primary-gold text-xs uppercase tracking-wider shadow-xl cursor-pointer">
      Inquire About Advertising &rarr;
    </a>
  </div>
</div>
