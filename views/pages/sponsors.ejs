<!-- KWIZZ Radio Sponsors & Advertising Page -->
<div class="space-y-10 max-w-5xl mx-auto">
  <div class="border-b border-zinc-800/80 pb-6 text-center space-y-2">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-gold text-xs font-semibold">
      <span>SUPPORT OUR COMMUNITY PARTNERS</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black text-white" style="color: var(--text-primary);">
      Sponsors &amp; Advertisers
    </h1>
    <p class="text-zinc-400 text-sm max-w-xl mx-auto">
      These businesses and community organizations make independent 24/7 Caribbean broadcasting possible in Ottawa.
    </p>
  </div>

  <!-- Sponsor Directory Grid -->
  <div class="space-y-6">
    <h2 class="text-xl font-bold text-white" style="color: var(--text-primary);">Featured Community Partners</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% if (typeof sponsors !== 'undefined' && sponsors.length > 0) { %>
        <% sponsors.forEach(sp => { %>
          <div class="p-6 kwizz-card flex flex-col items-center text-center justify-between space-y-4" style="background-color: var(--bg-card);">
            <div class="w-20 h-20 rounded-2xl bg-zinc-900 border border-zinc-800 flex items-center justify-center p-3 shadow-inner">
              <img src="<%= sp.logoUrl || '/images/fallback-album.svg' %>" alt="<%= sp.name %>" class="max-h-full max-w-full object-contain">
            </div>
            <div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-400 block mb-1">
                <%= sp.placement %> PARTNER
              </span>
              <h3 class="text-base font-black text-white" style="color: var(--text-primary);"><%= sp.name %></h3>
            </div>
            <a href="/api/sponsors/<%= sp.id %>/click?target=<%= encodeURIComponent(sp.targetUrl) %>" target="_blank" rel="noopener sponsored" class="w-full py-2.5 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs font-bold text-white transition-colors">
              Visit Website &rarr;
            </a>
          </div>
        <% }); %>
      <% } else { %>
        <div class="col-span-3 p-8 text-center text-zinc-500">
          No sponsors active at this time.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Advertising Pitch Callout -->
  <div class="rounded-3xl bg-gradient-to-r from-amber-950/30 via-zinc-950 to-emerald-950/30 border border-zinc-800/80 p-8 sm:p-10 text-center space-y-4">
    <h2 class="text-2xl font-black text-white" style="color: var(--text-primary);">
      Promote Your Business with KWIZZ Radio
    </h2>
    <p class="text-zinc-300 text-sm max-w-2xl mx-auto leading-relaxed">
      Reach thousands of engaged listeners in Ottawa, Gatineau, Montreal, Toronto, and our global Caribbean stream audience. We offer non-intrusive banner placements, sponsored show segments, and live event broadcasts.
    </p>
    <a href="/contact" class="inline-block px-7 py-3.5 rounded-2xl btn-primary-gold text-xs uppercase tracking-wider shadow-xl">
      Inquire About Advertising &rarr;
    </a>
  </div>
</div>

