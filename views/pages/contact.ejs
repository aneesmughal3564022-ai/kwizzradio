<!-- KWIZZ Radio Contact Page -->
<div class="space-y-10 max-w-4xl mx-auto">
  <div class="text-center space-y-2 border-b border-zinc-800/80 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full badge-gold text-xs font-semibold">
      <span>OTTAWA BROADCAST HEADQUARTERS</span>
    </div>
    <h1 class="text-3xl sm:text-4xl font-black text-white" style="color: var(--text-primary);">
      Contact KWIZZ Radio
    </h1>
    <p class="text-zinc-400 text-sm max-w-xl mx-auto">
      Connect with station management, submit community announcements, inquire about advertising, or reach out to our team.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
    
    <!-- Left Column: Contact Form -->
    <div class="md:col-span-7">
      <form id="contact-station-form" class="space-y-5 kwizz-card p-6 sm:p-8 shadow-xl" style="background-color: var(--bg-card);" novalidate>
        <!-- Spam Honeypot -->
        <div class="hidden" aria-hidden="true">
          <label for="hp_phone">Do not fill this</label>
          <input type="text" id="hp_phone" name="hp_phone" tabindex="-1" autocomplete="off">
        </div>
        <input type="hidden" id="contact_rendered_at" name="rendered_at" value="">

        <div>
          <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">
            Your Name <span class="text-rose-500">*</span>
          </label>
          <input 
            type="text" 
            id="contact-name" 
            name="name" 
            required 
            placeholder="John Doe"
            class="w-full px-4 py-3 rounded-xl kwizz-input text-white placeholder-zinc-500 text-sm">
        </div>

        <div>
          <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">
            Your Email <span class="text-rose-500">*</span>
          </label>
          <input 
            type="email" 
            id="contact-email" 
            name="email" 
            required 
            placeholder="john@example.com"
            class="w-full px-4 py-3 rounded-xl kwizz-input text-white placeholder-zinc-500 text-sm">
        </div>

        <div>
          <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">
            Subject
          </label>
          <input 
            type="text" 
            id="contact-subject" 
            name="subject" 
            placeholder="Sponsorship inquiry / Feedback / General question"
            class="w-full px-4 py-3 rounded-xl kwizz-input text-white placeholder-zinc-500 text-sm">
        </div>

        <div>
          <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-zinc-300 mb-2">
            Message <span class="text-rose-500">*</span>
          </label>
          <textarea 
            id="contact-message" 
            name="message" 
            rows="4" 
            required 
            placeholder="How can we help you?"
            class="w-full px-4 py-3 rounded-xl kwizz-input text-white placeholder-zinc-500 text-sm resize-none"></textarea>
        </div>

        <!-- CASL Consent Checkbox -->
        <div class="flex items-start gap-3">
          <input 
            type="checkbox" 
            id="contact-consent" 
            name="caslConsent" 
            class="mt-1 w-4 h-4 rounded border-zinc-700 text-amber-500 focus:ring-amber-400 bg-zinc-900">
          <label for="contact-consent" class="text-xs text-zinc-400 leading-relaxed cursor-pointer">
            I consent to receiving a reply and occasional station newsletters in compliance with Canada's Anti-Spam Legislation (CASL).
          </label>
        </div>

        <div id="contact-feedback" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

        <button 
          type="submit" 
          id="contact-submit-btn" 
          class="w-full py-3.5 rounded-xl btn-primary-gold text-sm uppercase tracking-wider flex items-center justify-center gap-2">
          <span class="btn-text">Submit Message</span>
          <span class="btn-spinner hidden">
            <svg class="w-5 h-5 animate-spin text-black" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
          </span>
        </button>
      </form>
    </div>

    <!-- Right Column: Station Details & Info -->
    <div class="md:col-span-5 space-y-6">
      <div class="kwizz-card p-6 space-y-4" style="background-color: var(--bg-card);">
        <h3 class="text-lg font-black text-white" style="color: var(--text-primary);">Station Information</h3>
        
        <div class="space-y-3 text-xs text-zinc-300">
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <div>
              <strong class="text-white block">Location:</strong>
              Ottawa, Ontario, Canada (Eastern Time)
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <div>
              <strong class="text-white block">General Inquiries:</strong>
              <a href="mailto:info@kwizzradio.ca" class="text-amber-400 hover:underline">info@kwizzradio.ca</a>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
            <div>
              <strong class="text-white block">Song Requests &amp; Shoutouts:</strong>
              Use our instant <a href="/request" class="text-amber-400 underline">Song Request Form</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Social Card -->
      <div class="kwizz-card p-6" style="background-color: var(--bg-card);">
        <h4 class="text-sm font-bold text-white mb-2" style="color: var(--text-primary);">Connect on Socials</h4>
        <p class="text-xs text-zinc-400 mb-4">Follow us for weekly DJ lineups and reggae live sessions.</p>
        <div class="flex items-center gap-3">
          <a href="https://instagram.com/kwizzradio" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs font-semibold text-white transition-colors">Instagram</a>
          <a href="https://facebook.com/kwizzradio" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs font-semibold text-white transition-colors">Facebook</a>
          <a href="https://x.com/kwizzradio" target="_blank" rel="noopener noreferrer" class="px-3.5 py-2 rounded-xl bg-zinc-900/90 hover:bg-zinc-800 border border-zinc-700/80 text-xs font-semibold text-white transition-colors">X / Twitter</a>
        </div>
      </div>
    </div>

  </div>
</div>

<script src="/js/forms.js"></script>

